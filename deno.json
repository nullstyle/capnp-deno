{
  "name": "@nullstyle/capnp",
  "version": "0.5.0",
  "license": "MIT",
  "exports": {
    ".": "./src/mod.ts",
    "./encoding": "./src/encoding.ts",
    "./rpc": "./src/rpc.ts",
    "./advanced": "./src/advanced.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.0.0"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "generated/*.wasm",
      "generated/*.provenance.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/**",
      "bench/**",
      "docs/**",
      "examples/**",
      "scripts/**",
      "tools/**",
      "coverage/**",
      "vendor/**",
      ".git/**"
    ]
  },
  "include": [
    "generated/*.wasm",
    "generated/*.provenance.json"
  ],
  "exclude": [
    "vendor/**",
    ".capnp-cache/**"
  ],
  "tasks": {
    "fmt": "deno fmt src tests bench examples docs scripts tools deno.json README.md AGENTS.md",
    "lint": "deno lint",
    "check": "deno check src/*.ts src/encoding/*.ts src/wasm/*.ts src/observability/*.ts src/rpc/*.ts src/rpc/server/*.ts src/rpc/session/*.ts src/rpc/wire/*.ts src/rpc/transports/*.ts tools/*.ts tools/capnpc-deno/*.ts scripts/*.ts tests/*.ts tests/**/*_test.ts bench/*.ts examples/*/*.ts examples/*/gen/*.ts",
    "check:generated": "deno check tests/fixtures/generated/typegate_fixture_capnp.ts tests/fixtures/generated/typegate_fixture_rpc.ts tests/fixtures/generated/interop_matrix/mod.ts tests/fixtures/generated/crossfile/base_types.ts tests/fixtures/generated/crossfile/base_meta.ts tests/fixtures/generated/crossfile/consumer_types.ts tests/fixtures/generated/crossfile/consumer_meta.ts tests/fixtures/generated/crossfile/nested/deep_types.ts tests/fixtures/generated/crossfile/nested/deep_meta.ts src/rpc/gen/capnp/mod.ts",
    "check:rpc-schema-sync": "deno run --allow-read --allow-write --allow-run=deno scripts/rpc_schema.ts --check",
    "check:tools": "deno check tools/*.ts tools/capnpc-deno/*.ts scripts/*.ts",
    "codegen": "deno run --allow-read --allow-write tools/capnpc-deno/main.ts",
    "codegen:compile": "deno run --allow-read --allow-write --allow-run=deno scripts/build_capnpc_deno_binary.ts",
    "codegen:install": "deno run --allow-read --allow-write --allow-env=DENO_INSTALL_ROOT,HOME,USERPROFILE --allow-run=deno scripts/install_compiler.ts",
    "codegen:uninstall": "deno run --allow-read --allow-write --allow-env=DENO_INSTALL_ROOT,HOME,USERPROFILE --allow-run=deno scripts/install_compiler.ts --uninstall",
    "test:codegen": "deno test --allow-read=tests/fixtures/codegen_requests,src,generated/capnp_deno.wasm,tools/capnpc-deno,tests/codegen tests/codegen/capnpc_deno_codegen_test.ts tests/codegen/capnpc_deno_evolution_test.ts tests/codegen/capnpc_deno_union_codegen_test.ts tests/codegen/capnpc_deno_interface_codegen_test.ts tests/codegen/capnpc_deno_close_collision_test.ts tests/codegen/capnpc_deno_cli_test.ts tests/codegen/capnpc_deno_golden_codegen_test.ts tests/codegen/capnpc_deno_crossfile_codegen_test.ts tests/codegen/capnpc_deno_source_hygiene_test.ts tests/codegen/capnpc_deno_plugin_response_test.ts",
    "test:unit": "deno test --allow-read=tests/fixtures/framing,tests/fixtures/codegen_requests,src,generated/capnp_deno.wasm,tools/capnpc-deno,tests/codegen tests --ignore=tests/wasm/real_wasm_wire_conformance_test.ts,tests/wasm/runtime_artifact_test.ts,tests/wasm/real_wasm_ownership_test.ts,tests/transports/socket_integration_test.ts,tests/wasm/real_wasm_serde_test.ts,tests/wasm/real_wasm_rpc_flow_test.ts,tests/wasm/real_wasm_service_flow_test.ts,tests/transports/tcp_rpc_interop_test.ts,tests/codegen/capnpc_deno_cli_e2e_test.ts,tests/codegen/compiler_integration_test.ts",
    "test:coverage": "deno task test:unit --coverage=coverage/",
    "test:integration": "deno test tests/transports/socket_integration_test.ts --allow-net='127.0.0.1,localhost,[::1]' --unstable-net",
    "test:codegen-e2e": "deno test tests/codegen/capnpc_deno_cli_e2e_test.ts --allow-read --allow-write --allow-run",
    "test:browser-webtransport": "deno test tests/browser/webtransport_browser_e2e.ts --allow-env --allow-sys --allow-read --allow-write --allow-net=127.0.0.1 --allow-run --unstable-net",
    "test:real": "deno test tests/wasm/real_wasm_wire_conformance_test.ts tests/wasm/real_wasm_ownership_test.ts tests/wasm/runtime_artifact_test.ts tests/wasm/real_wasm_serde_test.ts tests/wasm/real_wasm_rpc_flow_test.ts tests/wasm/real_wasm_service_flow_test.ts tests/transports/tcp_rpc_interop_test.ts --allow-read --allow-net=127.0.0.1",
    "test": "deno task test:unit",
    "build:wasm": "deno run --allow-read --allow-write --allow-env --allow-run=git,zig,wasm-opt scripts/build_wasm.ts",
    "smoke:real": "deno run --allow-read examples/smoke_real_wasm/smoke_real_wasm.ts",
    "bench": "deno task bench:fast",
    "bench:fast": "deno bench bench --ignore=bench/real_wasm_bench.ts",
    "bench:real": "deno bench bench/real_wasm_bench.ts --allow-read=generated/capnp_deno.wasm",
    "verify": "deno task fmt:check && deno task lint && deno task check:wasm && deno task check && deno task check:generated && deno task check:rpc-schema-sync && deno task test:unit",
    "verify:real": "deno task build:wasm && deno task smoke:real && deno task test:integration && deno task test:real",
    "fmt:check": "deno fmt --check src tests bench examples docs scripts tools deno.json README.md AGENTS.md",
    "check:wasm": "deno run --allow-read tools/runtime_artifact.ts",
    "check:wasm-rebuild": "deno run --allow-read --allow-write --allow-env --allow-run=git,zig,wasm-opt scripts/build_wasm.ts --check",
    "compiler:fetch": "deno run --allow-read --allow-write=.capnp-cache --allow-net=github.com,release-assets.githubusercontent.com tools/compiler_artifact.ts --fetch",
    "check:compiler": "deno run --allow-read tools/compiler_artifact.ts",
    "check:compiler-binary": "deno run --allow-read --allow-write --allow-run --allow-env scripts/check_compiler_binary.ts",
    "check:package": "deno run --allow-read --allow-write --allow-env --allow-run=deno scripts/check_package.ts",
    "codegen:rpc": "deno run --allow-read --allow-write --allow-run=deno scripts/rpc_schema.ts",
    "test:native-interop": "deno run --allow-read --allow-write --allow-run --allow-env --allow-net=127.0.0.1 scripts/native_interop.ts",
    "compiler:maintenance:fetch": "python3 vendor/capnp-zig/tools/bootstrap_capnp.py",
    "fixtures:codegen": "deno run --allow-read --allow-write --allow-run=python3 tests/codegen/generate_evolution_fixtures.ts",
    "test:compiler": "deno test --allow-read --allow-write --allow-run=deno tests/codegen/compiler_artifact_test.ts tests/codegen/compiler_workspace_test.ts tests/codegen/compiler_integration_test.ts",
    "check:compiler-install": "deno run --allow-read --allow-write --allow-env --allow-run=deno scripts/check_compiler_install.ts",
    "bench:compiler": "deno run --no-prompt --allow-read bench/compiler_bench.ts",
    "check:release-version": "deno run --allow-read=deno.json scripts/check_release_version.ts",
    "bench:stream-memory": "deno run --allow-read bench/streaming_memory.ts"
  },
  "lint": {
    "exclude": [
      "vendor/capnp-zig/vendor/**",
      "**/generated/**",
      "**/gen/**",
      "**/*_capnp.ts",
      "**/*_rpc.ts",
      "**/*_meta.ts",
      "**/*_types.ts"
    ]
  },
  "compilerOptions": {
    "strict": true
  }
}
